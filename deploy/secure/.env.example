# Secure OpenClaw deployment — environment variables.
# Copy this to .env and fill in your values.

# OpenClaw image (build locally or pull from registry)
OPENCLAW_IMAGE=openclaw:local

# Gateway auth token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# Gateway bind mode: lan | localhost | 0.0.0.0
OPENCLAW_GATEWAY_BIND=lan

# Host ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Config and workspace paths on the host
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./.openclaw/workspace
