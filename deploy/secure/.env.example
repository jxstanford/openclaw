# Secure OpenClaw deployment — environment variables.
# Copy this to .env and fill in your values.

# OpenClaw image (build locally or pull from registry)
OPENCLAW_IMAGE=openclaw:local

# Gateway auth token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# Gateway bind mode: lan | localhost | 0.0.0.0
OPENCLAW_GATEWAY_BIND=lan

# Host ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Config and workspace paths on the host
OPENCLAW_CONFIG_DIR=./.openclaw
OPENCLAW_WORKSPACE_DIR=./.openclaw/workspace
OPENCLAW_WORKSPACE_WORK_DIR=./.openclaw/workspace-work
OPENCLAW_WORKSPACE_PUBLIC_DIR=./.openclaw/workspace-public

# ── Signal ──────────────────────────────────────────────────────
# Phone number in E.164 format (e.g. +15551234567)
SIGNAL_ACCOUNT=
# Mode: daemon (default), link (QR pairing), register (SMS), shell
SIGNAL_MODE=daemon

# ── Slack ───────────────────────────────────────────────────────
# Bot Token (xoxb-...) from Slack App > OAuth & Permissions
SLACK_BOT_TOKEN=
# App Token (xapp-...) from Slack App > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=
